{
  "name": "@emergent-wisdom/understanding-graph-web-server",
  "version": "0.1.11",
  "description": "Web server for understanding graph visualization",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/emergent-wisdom/understanding-graph.git",
    "directory": "packages/web-server"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-server-json.mjs",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --ext ts --exec 'tsx src/index.ts'",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@emergent-wisdom/understanding-graph-core": "0.1.12",
    "@emergent-wisdom/understanding-graph-mcp-server": "0.1.12",
    "dotenv": "^17.2.3",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "nodemon": "^3.1.11",
    "tsx": "^4.20.6",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  }
}
